package templates

templ Header(title string) {
    <!Doctype html>
    <html lang="ru">
    <header>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{title}</title>
    </header>
    <body>
    <h1>Main page</h1>
    { children... }
    </body>
    </html>
}